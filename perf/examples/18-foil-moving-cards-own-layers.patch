+/* A moving card's foil keeps its own layers, so tilting the card moves them without repainting the gradients. */
+:is(.card-drag-preview, .card-flight)[data-foil]:not([data-foil="none"])::before,
+:is(.card-drag-preview, .card-flight)[data-foil]:not([data-foil="none"])::after {
+    will-change: transform;
+}
